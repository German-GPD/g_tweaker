<Window
    x:Class="G_Tweaker.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="G_Tweaker">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="24,18,24,14">
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{ThemeResource AccentFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE713;" FontSize="22" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Spacing="0">
                        <TextBlock Text="G_Tweaker" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Windows control center" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" PlaceholderText="Search tweaks…" QueryIcon="Find" TextChanged="SearchBox_TextChanged" VerticalAlignment="Center"/>
            </Grid>
        </Border>
        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        PaneDisplayMode="Left" SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="Home">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE80F;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="All tweaks" Tag="All">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Privacy" Tag="Privacy">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Performance" Tag="Performance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D9;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Input" Tag="Input">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE765;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Explorer" Tag="Explorer">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8B7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Gaming" Tag="Gaming">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE7FC;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Profiles" Tag="Profiles">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Activation" Tag="Activation">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE72E;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History" Tag="History">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE81C;"/></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <Grid Padding="26,18,26,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ContentPanel" Spacing="18">
                        <TextBlock x:Name="PageTitle" Text="Welcome back" FontSize="30" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PageSubtitle" Text="Tune Windows with clear explanations and reversible changes." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        <ItemsRepeater x:Name="TweakRepeater">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="12"/>
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            CornerRadius="12" Padding="18">
                                        <StackPanel Spacing="10">
                                            <Grid ColumnSpacing="18">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding State}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Warning}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button Content="Apply" Tag="{Binding Id}" Click="Apply_Click" Style="{StaticResource AccentButtonStyle}"/>
                                                <Button Content="Restore configured value" Tag="{Binding Id}" Click="Restore_Click" IsEnabled="{Binding CanRestore}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                        <StackPanel x:Name="ProfilesPanel" Spacing="12" Visibility="Collapsed"/>
                        <StackPanel x:Name="ActivationPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Windows activation" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock x:Name="ActivationStatus" Text="Activation status has not been checked." TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Check status" Click="CheckActivation_Click" Style="{StaticResource AccentButtonStyle}"/>
                                <Button Content="Open Activation settings" Click="OpenActivation_Click"/>
                            </StackPanel>
                            <InfoBar IsOpen="True" Severity="Informational" Title="Supported activation only"
                                     Message="G_Tweaker uses Windows' own activation settings. It does not bypass licensing."/>
                        </StackPanel>
                        <StackPanel x:Name="HistoryPanel" Spacing="12" Visibility="Collapsed">
                            <TextBlock Text="Change history" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="The latest change can be rolled back to its recorded previous registry value." TextWrapping="Wrap"/>
                            <Button Content="Roll back latest change" Click="Rollback_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left"/>
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12" Margin="0,0,0,8" CornerRadius="8"
                                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                                            <StackPanel Spacing="4">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </NavigationView>
        <Border Grid.Row="2" Padding="18,8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <TextBlock x:Name="StatusText" Text="Ready" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </Border>
    </Grid>
</Window>
